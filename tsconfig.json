{
  "compilerOptions": {
    "rootDir": "..",
    "baseUrl": "./",
    "paths": {
      "@components": ["src/components"],
      "@components/*": ["src/components/*"],
      "@services": ["src/services"],
      "@services/*": ["src/services/*"],
      "@src": ["src"],
      "@src/*": ["src/*"],
      "@stores": ["src/stores"],
      "@stores/*": ["src/stores/*"],
      "@utils": ["src/utils"],
      "@utils/*": ["src/utils/*"],
      "@waves/js-test-env/augment": ["node_modules/@waves/js-test-env/dist/augment.d.ts"],
      "@waves/ride-language-server/suggestions": ["node_modules/@waves/ride-language-server/server/out/suggestions/index.d.ts"]
    },
    "outDir": "dist/",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "noEmitHelpers": true,
    "jsx": "react-jsx",
    "lib": ["dom", "es2020"],
    "types": ["@waves/waveskeeper-types", "long"],
    "target": "es2020",
    "downlevelIteration": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "strict": true,
    "strictFunctionTypes": false,
    "useUnknownInCatchVariables": false,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "pretty": true,
    "removeComments": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*", "typings/*"],
  "exclude": ["node_modules", "dist"]
}
